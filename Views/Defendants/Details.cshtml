
@{
    ViewData["Title"] = "Defendant Details";
    var d = ViewBag.Defendant;
}

<div class="container-fluid py-3">

    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Defendants
        </a>
    </div>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-person-vcard me-2"></i>Defendant Details
            </h2>
            <p class="text-muted mb-0">
                View defendant information and associated court cases
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@d.Id"
               class="btn btn-dark px-3">
                <i class="bi bi-pencil me-1"></i>Edit Defendant
            </a>

            <a asp-action="Delete" asp-route-id="@d.Id"
               class="btn btn-outline-danger px-3">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>

    <!-- Defendant Profile -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center me-3"
                     style="width: 48px; height: 48px;">
                    <i class="bi bi-person-fill fs-4"></i>
                </div>

                <div>
                    <h5 class="fw-bold text-dark mb-1">@d.Name</h5>
                    <small class="text-muted">
                        Defendant ID: @d.Id
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- Personal Information -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-person-lines-fill me-2"></i>Personal Information
                </h6>

                <div class="row g-4">

                    <div class="col-md-3">
                        <small class="text-muted d-block mb-1">Defendant ID</small>
                        <span class="badge bg-light text-dark border px-3 py-2">
                            @d.Id
                        </span>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block mb-1">SA ID Number</small>
                        <span class="fw-semibold text-dark">
                            @(d.Idnumber ?? "—")
                        </span>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block mb-1">Date of Birth</small>
                        <span class="fw-semibold text-dark">
                            @(d.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")
                        </span>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block mb-1">Gender</small>
                        <span class="fw-semibold text-dark">
                            @(d.Gender ?? "—")
                        </span>
                    </div>

                </div>
            </div>

            <hr class="border-secondary-subtle my-4" />

            <!-- Contact Information -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-telephone me-2"></i>Contact Information
                </h6>

                <div class="row g-4">

                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Nationality</small>
                        <span class="fw-semibold text-dark">
                            @(d.Nationality ?? "—")
                        </span>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Phone Number</small>
                        <span class="fw-semibold text-dark">
                            @(d.Phone ?? "—")
                        </span>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Residential Address</small>
                        <span class="fw-semibold text-dark">
                            @(d.Address ?? "—")
                        </span>
                    </div>

                </div>
            </div>

            <hr class="border-secondary-subtle my-4" />

            <!-- Custody Status -->
            <div>
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-lock me-2"></i>Custody Information
                </h6>

                @if (d.IsInCustody)
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                        <i class="bi bi-lock-fill me-1"></i>Currently In Custody
                    </span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i>Not In Custody
                    </span>
                }
            </div>

        </div>
    </div>

    <!-- Associated Court Cases -->
    @if (d.CourtCaseDefendants != null && d.CourtCaseDefendants.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-briefcase me-2"></i>Associated Court Cases
                        </h5>
                        <small class="text-muted">
                            Court cases linked to this defendant
                        </small>
                    </div>

                    <span class="badge bg-light text-dark border px-3 py-2">
                        @d.CourtCaseDefendants.Count Case(s)
                    </span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-secondary">Court Case</th>
                                <th class="py-3 text-uppercase small fw-bold text-secondary">Role</th>
                                <th class="py-3 text-uppercase small fw-bold text-secondary">Primary Defendant</th>
                                <th class="py-3 text-end pe-4 text-uppercase small fw-bold text-secondary">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cd in d.CourtCaseDefendants)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark">
                                            <i class="bi bi-folder2-open me-2 text-secondary"></i>
                                            @(cd.CourtCase?.OriginalCase?.Name ?? "—")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-dark">
                                            @(cd.Role ?? "—")
                                        </span>
                                    </td>

                                    <td>
                                        @if (cd.IsPrimary)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-3 py-2">
                                                No
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-controller="CourtCases"
                                           asp-action="Manage"
                                           asp-route-originalCaseId="@cd.CourtCase?.OriginalCaseId"
                                           class="btn btn-sm btn-outline-dark px-3">
                                            <i class="bi bi-gear me-1"></i>Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5">
                <i class="bi bi-folder2-open text-secondary fs-1"></i>
                <h5 class="fw-bold text-dark mt-3">No Associated Court Cases</h5>
                <p class="text-muted mb-0">
                    This defendant is not currently linked to any court cases.
                </p>
            </div>
        </div>
    }

</div>
