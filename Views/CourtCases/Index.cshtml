
@{
    ViewData["Title"] = "Court Cases";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-building me-2"></i>
            Court Cases
        </h3>
        <p class="text-muted mb-0">
            View and manage all court proceedings
        </p>
    </div>
</div>

<!-- Court Cases Card -->
<div class="card border-0 shadow-sm rounded-3">

    <!-- Card Header -->
    <div class="card-header bg-dark text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">
                    <i class="bi bi-folder2-open me-2"></i>
                    Court Proceedings
                </h5>
                <small class="text-white-50">
                    Registered court cases and their current status
                </small>
            </div>

            <span class="badge bg-light text-dark px-3 py-2">
                <i class="bi bi-list-ul me-1"></i>
                All Cases
            </span>
        </div>
    </div>

    <!-- Table -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-dark">Case Number</th>
                        <th class="py-3 text-dark">Original Case</th>
                        <th class="py-3 text-dark">Status</th>
                        <th class="py-3 text-dark">Court</th>
                        <th class="py-3 text-dark">Judge</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in ViewBag.CourtCases)
                    {
                        <tr>
                            <!-- Case Number -->
                            <td class="ps-4">
                                <span class="fw-semibold text-dark">
                                    @(item.CaseNumber ?? "—")
                                </span>
                            </td>

                            <!-- Original Case -->
                            <td>
                                <div class="fw-semibold text-dark">
                                    @item.OriginalCase?.Name
                                </div>
                                <small class="text-muted">
                                    @item.OriginalCase?.CaseNumber
                                </small>
                            </td>

                            <!-- Status -->
                            <td>
                                <span class="text-dark">
                                    @(item.Status ?? "—")
                                </span>
                            </td>

                            <!-- Court -->
                            <td>
                                <span class="text-dark">
                                    @(item.Court?.Name ?? "—")
                                </span>
                            </td>

                            <!-- Judge -->
                            <td>
                                <span class="text-dark">
                                    @(item.Judge?.Name ?? "—")
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center justify-content-end gap-2 flex-nowrap">
                                    <a asp-action="Manage"
                                       asp-route-originalCaseId="@item.OriginalCaseId"
                                       class="btn btn-sm btn-dark text-nowrap">
                                        <i class="bi bi-briefcase me-1"></i>
                                        Manage
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-dark"
                                       title="Edit Case">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- Footer -->
    <div class="card-footer bg-white border-top py-3">
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            Court case records and proceedings management.
        </small>
    </div>

</div>
