@model IEnumerable<CourtOnlineWeek5.Models.Charge>

@{
    ViewData["Title"] = "Charges";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-journal-text me-2"></i>Charges
        </h2>
        <p class="text-muted mb-0">
            View and manage all recorded court charges.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">



        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0" id="chargesTable">

                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">Charge</th>
                        <th>Code</th>
                        <th>Statute</th>
                        <th>Plea</th>
                        <th>Severity</th>
                        <th>Court Case</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold">@item.Name</div>
                                <small class="text-muted">ID: @item.Id</small>
                            </td>

                            <td>
                                @(item.ChargeCode ?? "—")
                            </td>

                            <td>
                                @(item.Statute ?? "—")
                            </td>

                            <td>
                                @(item.Plea ?? "—")
                            </td>

                            <td>
                                @(item.Severity ?? "—")
                            </td>

                            <td>
                                <div class="fw-medium">
                                    @(item.CourtCase?.OriginalCase?.Name ?? "Unknown case")
                                </div>
                                <small class="text-muted">
                                    @(item.CourtCase?.CaseNumber ?? "—")
                                </small>
                            </td>

                            <td class="pe-4">
                                <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-dark text-nowrap">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary text-nowrap">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger text-nowrap">
                                        <i class="bi bi-trash3 me-1"></i>Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-folder2-open display-5 text-muted"></i>
                                <h5 class="mt-3 fw-semibold">No Charges Found</h5>
                                <p class="text-muted mb-0">
                                    There are currently no recorded charges.
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <div class="card-footer bg-white border-top p-3">
        <small class="text-muted">
            <i class="bi bi-shield-check me-1"></i>
            Court Management System | Charge Register
        </small>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("chargeSearch").addEventListener("input", function () {
            const search = this.value.toLowerCase();

            document.querySelectorAll("#chargesTable tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(search)
                    ? ""
                    : "none";
            });
        });
    </script>
}
