@model CourtOnlineWeek5.Models.Charge

@{
    ViewData["Title"] = "Charge Details";
}

<div class="mb-4">
    <a asp-controller="CourtCases"
       asp-action="Manage"
       asp-route-originalCaseId="@Model.CourtCase?.OriginalCaseId"
       class="btn btn-outline-dark btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Court Case
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">

    <div class="card-header bg-dark text-white p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-text fs-3 me-3"></i>
                <div>
                    <h4 class="mb-1">@Model.Name</h4>
                    <small class="text-white-50">Charge Details and Information</small>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-light btn-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-outline-light btn-sm">
                    <i class="bi bi-trash3 me-1"></i> Delete
                </a>
            </div>

        </div>
    </div>

    <div class="card-body p-4">

        <h6 class="text-uppercase fw-bold text-secondary mb-3">
            <i class="bi bi-info-circle me-2"></i>Charge Information
        </h6>

        <div class="bg-light border rounded-3 p-4 mb-4">

            <dl class="row mb-0">

                <dt class="col-sm-3 text-secondary">Charge Code</dt>
                <dd class="col-sm-9 fw-semibold">
                    @(Model.ChargeCode ?? "—")
                </dd>

                <dt class="col-sm-3 text-secondary">Statute</dt>
                <dd class="col-sm-9">
                    @(Model.Statute ?? "—")
                </dd>

                <dt class="col-sm-3 text-secondary">Plea</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-dark">
                        @(Model.Plea ?? "Not entered")
                    </span>
                </dd>

                <dt class="col-sm-3 text-secondary">Severity</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">
                        @(Model.Severity ?? "Not specified")
                    </span>
                </dd>

                <dt class="col-sm-3 text-secondary">Description</dt>
                <dd class="col-sm-9">
                    @(Model.Description ?? "No description provided")
                </dd>

            </dl>

        </div>

        <h6 class="text-uppercase fw-bold text-secondary mb-3">
            <i class="bi bi-briefcase me-2"></i>Associated Court Case
        </h6>

        <div class="border rounded-3 p-4">

            <div class="d-flex align-items-center">
                <div class="bg-dark text-white rounded-3 p-3 me-3">
                    <i class="bi bi-folder2-open fs-4"></i>
                </div>

                <div>
                    <div class="fw-bold">
                        @(Model.CourtCase?.OriginalCase?.Name ?? "Unknown case")
                    </div>

                    <small class="text-muted">
                        Case Number: @(Model.CourtCase?.CaseNumber ?? "—")
                    </small>
                </div>
            </div>

        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">
                <i class="bi bi-shield-check me-1"></i>
                Court Case Management System
            </small>

            <a asp-controller="CourtCases"
               asp-action="Manage"
               asp-route-originalCaseId="@Model.CourtCase?.OriginalCaseId"
               class="btn btn-outline-dark px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Court Case
            </a>
        </div>

    </div>
</div>
