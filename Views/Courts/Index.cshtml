@{
    ViewData["Title"] = "Courts";
}

<div class="container-fluid py-3">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-building me-2"></i>Courts
            </h2>
            <p class="text-muted mb-0">
                Manage courts, locations and court information
            </p>
        </div>

        <a asp-action="Create" class="btn btn-dark px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Add Court
        </a>
    </div>

    <!-- Courts Card -->
    <div class="card border-0 shadow-sm rounded-3">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-dark mb-1">Court Directory</h5>
                    <small class="text-muted">All registered courts and their details</small>
                </div>

                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-list-ul me-1"></i>
                    Court Records
                </span>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4 py-3">Court Name</th>
                            <th>Code</th>
                            <th>Level</th>
                            <th>Location</th>
                            <th>Province</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in ViewBag.Courts)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-building me-2 text-secondary"></i>
                                        @item.Name
                                    </div>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @(item.CourtCode ?? "—")
                                    </span>
                                </td>

                                <td class="text-dark">
                                    @(item.CourtLevel ?? "—")
                                </td>

                                <td class="text-secondary">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @item.Location
                                </td>

                                <td class="text-dark">
                                    @(item.Province ?? "—")
                                </td>

                                <!-- Actions -->
                                <td class="pe-4">
                                    <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-dark text-nowrap">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary text-nowrap">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger text-nowrap">
                                            <i class="bi bi-trash3 me-1"></i>Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-white border-top py-3 px-4">
            <small class="text-muted">
                <i class="bi bi-shield-check me-1"></i>
                Court Management System
            </small>
        </div>

    </div>
</div>