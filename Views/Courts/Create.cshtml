@model CourtOnlineWeek5.Models.Court

@{
    ViewData["Title"] = "Add Court";
}

<div class="container-fluid py-3">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-building me-2"></i>Add Court
            </h3>
            <p class="text-muted mb-0">
                Register a new court and provide its contact and location details.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-2"></i>Back to Courts
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-pencil-square me-2"></i>Court Information
            </h5>
        </div>

        <div class="card-body p-3 p-md-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-4"
                     role="alert"></div>

                <!-- Basic Information -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-info-circle me-2"></i>Basic Information
                    </h6>

                    <div class="row g-3">

                        <div class="col-12 col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Court Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter court name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="CourtCode" class="form-label fw-semibold">
                                Court Code
                            </label>
                            <input asp-for="CourtCode"
                                   class="form-control"
                                   placeholder="e.g. JHB-HC" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="CourtLevel" class="form-label fw-semibold">
                                Court Level
                            </label>
                            <select asp-for="CourtLevel" class="form-select">
                                <option value="">Select Court Level</option>
                                <option>High Court</option>
                                <option>Magistrate Court</option>
                                <option>Regional Court</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Location" class="form-label fw-semibold">
                                Location <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="Enter city or town" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Province" class="form-label fw-semibold">
                                Province
                            </label>
                            <input asp-for="Province"
                                   class="form-control"
                                   placeholder="Enter province" />
                        </div>

                    </div>
                </div>

                <!-- Contact Information -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-telephone me-2"></i>Contact Information
                    </h6>

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">
                                Phone Number
                            </label>
                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email Address
                            </label>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter email address" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">
                                Physical Address
                            </label>
                            <input asp-for="Address"
                                   class="form-control"
                                   placeholder="Enter full physical address" />
                        </div>

                    </div>
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-toggle-on me-2"></i>Court Status
                    </h6>

                    <div class="form-check form-switch">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               checked />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">
                            Active Court
                        </label>
                        <div class="form-text">
                            Indicates whether this court is currently active in the system.
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 border-top pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>

                    <button type="submit" class="btn btn-dark px-4">
                        <i class="bi bi-plus-circle me-2"></i>Create Court
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>