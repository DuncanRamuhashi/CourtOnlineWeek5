@{
    ViewData["Title"] = "Court Details";
    var court = ViewBag.Court;
}

<div class="container-fluid py-3">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-building me-2"></i>Court Details
            </h3>
            <p class="text-muted mb-0">
                View court information, contact details and current status.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-2"></i>Back to Courts
        </a>
    </div>

    <!-- Court Information Card -->
    <div class="card border-0 shadow-sm mb-4">

        <!-- Dark Header -->
        <div class="card-header bg-dark text-white p-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="bi bi-bank me-2"></i>@court.Name
                    </h4>
                    <small class="text-white-50">
                        Court Code: @(court.CourtCode ?? "Not assigned")
                    </small>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@court.Id"
                       class="btn btn-light btn-sm">
                        <i class="bi bi-pencil-square me-1"></i>Edit Court
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@court.Id"
                       class="btn btn-outline-light btn-sm">
                        <i class="bi bi-trash3 me-1"></i>Delete
                    </a>
                </div>

            </div>
        </div>

        <div class="card-body p-3 p-md-4">

            <!-- Status -->
            <div class="mb-4">
                <span class="text-muted small fw-semibold me-2">COURT STATUS</span>

                @if (court.IsActive)
                {
                    <span class="badge bg-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2">
                        <i class="bi bi-pause-circle me-1"></i>Inactive
                    </span>
                }
            </div>

            <div class="row g-4">

                <!-- General Information -->
                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 h-100">

                        <div class="bg-light border-bottom p-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-info-circle me-2"></i>General Information
                            </h6>
                        </div>

                        <div class="p-3">
                            <div class="row g-3">

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Court Name</small>
                                    <span class="fw-semibold text-dark">@court.Name</span>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Court Code</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.CourtCode ?? "—")
                                    </span>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Court Level</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.CourtLevel ?? "—")
                                    </span>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Status</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Location Information -->
                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 h-100">

                        <div class="bg-light border-bottom p-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-geo-alt me-2"></i>Location Information
                            </h6>
                        </div>

                        <div class="p-3">
                            <div class="row g-3">

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Location</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.Location ?? "—")
                                    </span>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <small class="text-muted d-block mb-1">Province</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.Province ?? "—")
                                    </span>
                                </div>

                                <div class="col-12">
                                    <small class="text-muted d-block mb-1">Physical Address</small>
                                    <span class="fw-semibold text-dark">
                                        @(court.Address ?? "—")
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="col-12">
                    <div class="border rounded-3">

                        <div class="bg-light border-bottom p-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-telephone me-2"></i>Contact Information
                            </h6>
                        </div>

                        <div class="p-3">
                            <div class="row g-3">

                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light rounded-3 p-3">
                                            <i class="bi bi-telephone-fill text-dark fs-5"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted d-block">Phone Number</small>
                                            <span class="fw-semibold text-dark">
                                                @(court.Phone ?? "—")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light rounded-3 p-3">
                                            <i class="bi bi-envelope-fill text-dark fs-5"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted d-block">Email Address</small>
                                            <span class="fw-semibold text-dark">
                                                @(court.Email ?? "—")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>