@{
    ViewData["Title"] = "Delete Court";
    var court = ViewBag.Court;
    var hasAssignments =
        (court.Judges != null && court.Judges.Count > 0) ||
        (court.CourtCases != null && court.CourtCases.Count > 0);
}

<div class="container-fluid py-3">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-trash3 me-2"></i>Delete Court
            </h3>
            <p class="text-muted mb-0">
                Review the court information before proceeding.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-2"></i>Back to Courts
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Confirm Court Deletion
                    </h5>
                </div>

                <div class="card-body p-3 p-md-4">

                    <!-- Warning Icon and Message -->
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-trash3 text-danger" style="font-size: 3rem;"></i>
                        </div>

                        <h5 class="fw-bold text-dark">Are you sure?</h5>

                        <p class="text-muted mb-0">
                            You are about to delete the following court.
                        </p>
                    </div>

                    <!-- Court Information -->
                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <small class="text-muted d-block">Court Name</small>
                                <span class="fw-semibold text-dark">
                                    @court.Name
                                </span>
                            </div>

                            <div class="col-12 col-md-6">
                                <small class="text-muted d-block">Court Code</small>
                                <span class="fw-semibold text-dark">
                                    @(court.CourtCode ?? "Not provided")
                                </span>
                            </div>

                            <div class="col-12 col-md-6">
                                <small class="text-muted d-block">Court Level</small>
                                <span class="fw-semibold text-dark">
                                    @(court.CourtLevel ?? "Not specified")
                                </span>
                            </div>

                            <div class="col-12 col-md-6">
                                <small class="text-muted d-block">Location</small>
                                <span class="fw-semibold text-dark">
                                    @(court.Location ?? "Not provided")
                                </span>
                            </div>

                        </div>
                    </div>

                    <!-- Assignment Warning -->
                    @if (hasAssignments)
                    {
                        <div class="alert alert-warning border-0 mb-4" role="alert">
                            <div class="d-flex gap-3">
                                <i class="bi bi-exclamation-triangle-fill fs-4"></i>

                                <div>
                                    <h6 class="fw-bold mb-1">Court cannot be deleted</h6>
                                    <p class="mb-0">
                                        This court has assigned judges or court cases.
                                        To preserve the existing records, deactivate the
                                        court instead of deleting it.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger border-0 mb-4" role="alert">
                            <div class="d-flex gap-3">
                                <i class="bi bi-exclamation-circle-fill fs-4"></i>

                                <div>
                                    <h6 class="fw-bold mb-1">This action cannot be undone</h6>
                                    <p class="mb-0">
                                        Deleting this court will permanently remove its
                                        record from the system.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Actions -->
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@court.Id" />

                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 border-top pt-4">

                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>

                            @if (!hasAssignments)
                            {
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-trash3 me-2"></i>Delete Court
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary px-4" disabled>
                                    <i class="bi bi-lock me-2"></i>Deletion Restricted
                                </button>
                            }

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>