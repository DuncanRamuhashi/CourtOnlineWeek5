
@{
    ViewData["Title"] = "Prosecutor Details";
    var p = ViewBag.Prosecutor;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Prosecutors
    </a>
</div>

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">
        <i class="bi bi-person-badge me-2"></i>Prosecutor Details
    </h2>
    <p class="text-muted mb-0">View prosecutor information and account status.</p>
</div>

<div class="card border-0 shadow-sm rounded-3">

    <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-person-vcard me-2"></i>@p.Name
        </h5>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-light btn-sm">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>

            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-outline-light btn-sm">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>

    <div class="card-body p-4">

        <h6 class="fw-bold text-dark mb-3">
            <i class="bi bi-info-circle me-2"></i>Professional Information
        </h6>

        <dl class="row mb-0">

            <dt class="col-sm-3 text-secondary py-2">Prosecutor ID</dt>
            <dd class="col-sm-9 py-2">
                <span class="badge bg-light text-dark border">@p.Id</span>
            </dd>

            <dt class="col-sm-3 text-secondary py-2">Full Name</dt>
            <dd class="col-sm-9 fw-semibold text-dark py-2">@p.Name</dd>

            <dt class="col-sm-3 text-secondary py-2">Rank</dt>
            <dd class="col-sm-9 py-2">@(p.Rank ?? "—")</dd>

            <dt class="col-sm-3 text-secondary py-2">Office</dt>
            <dd class="col-sm-9 py-2">@(p.Office ?? "—")</dd>

        </dl>

        <hr class="my-4" />

        <h6 class="fw-bold text-dark mb-3">
            <i class="bi bi-telephone me-2"></i>Contact Information
        </h6>

        <dl class="row mb-0">

            <dt class="col-sm-3 text-secondary py-2">Email Address</dt>
            <dd class="col-sm-9 py-2">@(p.Email ?? "—")</dd>

            <dt class="col-sm-3 text-secondary py-2">Phone Number</dt>
            <dd class="col-sm-9 py-2">@(p.Phone ?? "—")</dd>

        </dl>

        <hr class="my-4" />

        <h6 class="fw-bold text-dark mb-3">
            <i class="bi bi-toggle-on me-2"></i>Account Status
        </h6>

        <div class="d-flex align-items-center gap-2">
            @if (p.IsActive)
            {
                <span class="badge bg-dark px-3 py-2">
                    <i class="bi bi-check-circle me-1"></i>Active
                </span>
                <span class="text-muted small">Prosecutor is currently active.</span>
            }
            else
            {
                <span class="badge bg-secondary px-3 py-2">
                    Inactive
                </span>
                <span class="text-muted small">Prosecutor is currently inactive.</span>
            }
        </div>

    </div>

    <div class="card-footer bg-white border-top p-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

</div>