```cshtml
@model CourtOnlineWeek5.Models.Prosecutor
@{
    ViewData["Title"] = "Register Prosecutor";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Prosecutors
    </a>
</div>

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">
        <i class="bi bi-person-badge me-2"></i>Register Prosecutor
    </h2>
    <p class="text-muted mb-0">Register a prosecutor and capture their professional and contact details.</p>
</div>

<div class="card border-0 shadow-sm rounded-3">

    <div class="card-header bg-dark text-white py-3 px-4">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-person-vcard me-2"></i>Prosecutor Information
        </h5>
    </div>

    <div class="card-body p-4">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h6 class="fw-bold text-dark mb-3">Professional Information</h6>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Id" class="form-label fw-semibold">Prosecutor ID *</label>
                    <input asp-for="Id" class="form-control" placeholder="e.g. PRO-013" />
                    <span asp-validation-for="Id" class="text-danger small"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="Name" class="form-label fw-semibold">Full Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Rank" class="form-label fw-semibold">Rank</label>
                    <select asp-for="Rank" class="form-select">
                        <option value="">Select Rank</option>
                        <option>State Advocate</option>
                        <option>Senior State Advocate</option>
                        <option>Advocate</option>
                    </select>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold text-dark mb-3">Office Information</h6>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Office" class="form-label fw-semibold">Office</label>
                    <input asp-for="Office" class="form-control" placeholder="e.g. NPA Johannesburg" />
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold text-dark mb-3">Contact Information</h6>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                    <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold text-dark mb-3">Account Status</h6>

            <div class="row">
                <div class="col-md-6">
                    <div class="bg-light border rounded-3 p-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">
                                Active
                            </label>
                        </div>
                        <small class="text-muted ms-4">
                            Indicates whether the prosecutor is currently active.
                        </small>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </a>

                <button type="submit" class="btn btn-dark px-4">
                    <i class="bi bi-check-circle me-1"></i>Register Prosecutor
                </button>
            </div>

        </form>
    </div>
</div>
```