
@{
    ViewData["Title"] = "Original Case Details";
    var oc = ViewBag.OriginalCase;
}

<!-- BACK BUTTON -->
<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Original Cases
    </a>
</div>

<!-- ORIGINAL CASE DETAILS -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-black text-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">

        <h4 class="mb-0 text-white">
            <i class="bi bi-folder2-open me-2"></i>
            @oc.Name
        </h4>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@oc.Id"
               class="btn btn-light btn-sm">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <a asp-controller="CourtCases"
               asp-action="Manage"
               asp-route-originalCaseId="@oc.Id"
               class="btn btn-outline-light btn-sm">
                <i class="bi bi-briefcase me-1"></i>
                Manage Court Case
            </a>

        </div>
    </div>

    <div class="card-body p-4">

        <h5 class="mb-3">
            <i class="bi bi-info-circle me-2"></i>
            Case Information
        </h5>

        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>Case Number:</strong>
                    <code>@oc.CaseNumber</code>
                </p>

                <p>
                    <strong>Date Opened:</strong>
                    @oc.Date.ToString("dd MMMM yyyy")
                </p>

                <p>
                    <strong>Case Type:</strong>
                    @oc.CaseType
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>Priority:</strong>

                    <span class="badge bg-dark">
                        @oc.Priority
                    </span>
                </p>

                <p>
                    <strong>Reported By:</strong>
                    @(oc.ReportedBy ?? "—")
                </p>

            </div>

        </div>

        @if (!string.IsNullOrEmpty(oc.Description))
        {
            <hr />

            <h6 class="fw-bold">
                <i class="bi bi-card-text me-2"></i>
                Case Description
            </h6>

            <p class="text-muted mb-0">
                @oc.Description
            </p>
        }

    </div>
</div>

<!-- RELATED COURT CASES -->
@if (oc.CourtCases != null && oc.CourtCases.Count > 0)
{
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-black text-white py-3">

            <h5 class="mb-0 text-white">
                <i class="bi bi-briefcase me-2"></i>
                Related Court Cases

                <span class="badge bg-white text-dark ms-2">
                    @oc.CourtCases.Count
                </span>
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Case Number</th>
                            <th>Status</th>
                            <th>Court</th>
                            <th>Judge</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var cc in oc.CourtCases)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @cc.CaseNumber
                                </td>

                                <td>
                                    <span class="badge bg-dark">
                                        @cc.Status
                                    </span>
                                </td>

                                <td>
                                    @(cc.Court?.Name ?? "Not Assigned")
                                </td>

                                <td>
                                    @(cc.Judge?.Name ?? "Not Assigned")
                                </td>

                                <td class="text-end">

                                    <a asp-controller="CourtCases"
                                       asp-action="Manage"
                                       asp-route-originalCaseId="@oc.Id"
                                       class="btn btn-sm btn-outline-dark">

                                        <i class="bi bi-gear me-1"></i>
                                        Manage

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <i class="bi bi-briefcase display-4 text-muted"></i>

            <h5 class="mt-3">No Court Cases Found</h5>

            <p class="text-muted">
                There are currently no court cases associated with this original case.
            </p>

            <a asp-controller="CourtCases"
               asp-action="Manage"
               asp-route-originalCaseId="@oc.Id"
               class="btn btn-dark">

                <i class="bi bi-plus-lg me-1"></i>
                Create Court Case

            </a>

        </div>

    </div>
}
```