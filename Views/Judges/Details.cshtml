```cshtml
@{
    ViewData["Title"] = "Judge Details";
    var judge = ViewBag.Judge;
}

<div class="container-fluid py-3">

    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Judges
        </a>
    </div>

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-person-badge me-2"></i>Judge Details
            </h2>
            <p class="text-muted mb-0">
                View judicial officer information and court assignment.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@judge.Id"
               class="btn btn-dark px-3">
                <i class="bi bi-pencil-square me-1"></i>Edit Judge
            </a>

            <a asp-action="Delete" asp-route-id="@judge.Id"
               class="btn btn-outline-danger px-3">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>

    <!-- Judge Profile Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center"
                     style="width:65px; height:65px;">
                    <i class="bi bi-person-badge fs-2"></i>
                </div>

                <div>
                    <h4 class="fw-bold text-dark mb-1">@judge.Name</h4>
                    <p class="text-muted mb-2">
                        @(judge.Title ?? "Judicial Officer")
                    </p>

                    @if (judge.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
                            <i class="bi bi-pause-circle me-1"></i>Inactive
                        </span>
                    }
                </div>
            </div>

        </div>
    </div>

    <div class="row g-4">

        <!-- Personal and Professional Information -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">

                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>Professional Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">Judge ID</small>
                        <span class="fw-semibold text-dark">
                            <code>@judge.Id</code>
                        </span>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">Title</small>
                        <span class="fw-semibold text-dark">
                            @(judge.Title ?? "—")
                        </span>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">Assigned Court</small>
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-building me-1 text-muted"></i>
                            @(judge.Court?.Name ?? "—")
                        </span>
                    </div>

                    <div>
                        <small class="text-muted d-block mb-1">Appointment Date</small>
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                            @(judge.AppointmentDate?.ToString("dd MMM yyyy") ?? "—")
                        </span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">

                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-telephone me-2"></i>Contact Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">Email Address</small>
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-envelope me-1 text-muted"></i>
                            @(judge.Email ?? "—")
                        </span>
                    </div>

                    <div>
                        <small class="text-muted d-block mb-1">Phone Number</small>
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-telephone me-1 text-muted"></i>
                            @(judge.Phone ?? "—")
                        </span>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Footer Actions -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-1"></i>Back to Judges
        </a>

        <a asp-action="Edit" asp-route-id="@judge.Id" class="btn btn-dark px-4">
            <i class="bi bi-pencil-square me-1"></i>Edit Judge
        </a>
    </div>

</div>
```