```cshtml
@{
    ViewData["Title"] = "Delete Judge";
    var judge = ViewBag.Judge;
}

<div class="container-fluid py-3">

    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Judges
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-x me-2"></i>Delete Judge
        </h2>
        <p class="text-muted mb-0">
            Review judge information before proceeding with deletion.
        </p>
    </div>

    <!-- Delete Confirmation Card -->
    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-header bg-white border-bottom py-3 px-4">
            <h5 class="fw-bold text-dark mb-1">
                Confirm Deletion
            </h5>
            <small class="text-muted">
                Judicial record removal
            </small>
        </div>

        <div class="card-body p-4">

            <!-- Warning Message -->
            <div class="alert alert-danger border-0 rounded-3 d-flex align-items-start mb-4">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Are you sure you want to delete this judge?</h6>
                    <p class="mb-0 small">
                        This action may permanently remove the judge's record.
                        Verify the information below before continuing.
                    </p>
                </div>
            </div>

            <!-- Judge Information -->
            <div class="border rounded-3 p-4 mb-4">

                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-person-badge me-2"></i>Judge Information
                </h6>

                <div class="row g-3">

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Full Name</small>
                        <span class="fw-semibold text-dark">
                            @judge.Name
                        </span>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Judge ID</small>
                        <span class="badge bg-light text-dark border px-3 py-2">
                            @judge.Id
                        </span>
                    </div>

                </div>
            </div>

            <!-- Court Case Assignment Check -->
            @if (judge.CourtCases != null && judge.CourtCases.Count > 0)
            {
                <div class="alert alert-warning border rounded-3">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-lock-fill fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Deletion Restricted</h6>
                            <p class="mb-0">
                                This judge is currently assigned to one or more court cases
                                and cannot be deleted.
                                Deactivate the judge instead to preserve court case records.
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border rounded-3">
                    <i class="bi bi-info-circle me-2"></i>
                    No associated court cases were found.
                    This judge's record can be deleted.
                </div>
            }

            <!-- Action Buttons -->
            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@judge.Id" />

                <div class="d-flex justify-content-end gap-2 border-top pt-4">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>

                    @if (judge.CourtCases == null || judge.CourtCases.Count == 0)
                    {
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete Judge
                        </button>
                    }

                </div>

            </form>

        </div>
    </div>
</div>
